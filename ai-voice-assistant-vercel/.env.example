# --------------------------------------------------------------------
# AI Voice Assistant (Vercel edition) - Environment Variables
# --------------------------------------------------------------------
# LOCAL DEV: copy this file to ".env" and fill in your real key, then
#            run `vercel dev` (reads .env automatically).
# PRODUCTION: do NOT use a .env file — instead add these same variables
#            in your Vercel project's dashboard under
#            Settings -> Environment Variables.
# --------------------------------------------------------------------

# Free API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# gemini-3-flash-preview is the current free-tier model (mid-2026).
# If Google has moved your account to the GA release, use "gemini-3.5-flash".
GEMINI_MODEL=gemini-3-flash-preview
